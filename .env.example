# Server only. Never prefix this variable with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=

# Server-only random secret shared by Preview/production function instances.
# Required for /qa and M5 task tickets in a production build; never use NEXT_PUBLIC_.
QA_TOOL_SIGNING_KEY=

# M5 local runtime: installed Python 3.11 with the fixed MetaGPT dependencies.
# Container deployment configures these automatically.
ATOMS_TEAM_PYTHON=
METAGPT_PROJECT_ROOT=
# Run the gateway after team:build; default port 3105.
PORT=3105
