# Server only. Never prefix this variable with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=

# Server-only random secret shared by Preview/production function instances.
# Required for /qa and M5 task tickets in a production build; never use NEXT_PUBLIC_.
QA_TOOL_SIGNING_KEY=

# M5 local runtime: installed Python 3.11 with the fixed MetaGPT dependencies.
# Container deployment configures these automatically.
ATOMS_TEAM_PYTHON=
METAGPT_PROJECT_ROOT=
# Run the gateway after team:build; default port 3105.
PORT=3105

# CloudBase user Auth (no Tencent management keys in the app).
CLOUDBASE_ENV_ID=
# 32 random bytes, hex encoded; stable across instances/deploys for this environment.
# Generate in a trusted secret manager; never commit or use NEXT_PUBLIC_.
ATOMS_AUTH_SECRET=
# Exact public origin, including https, no trailing slash. Required behind the gateway.
# Set independently for each deployment, e.g. http://localhost:3166 in local dev.
ATOMS_APP_ORIGIN=

# Server-only 32-byte hex HMAC key for trusted task artifacts (independent of Auth).
# Install the SAME value into atoms_private.artifact_key with migrate.mjs; ordinary
# users cannot read it. Preserve across instances/deploys. Never use NEXT_PUBLIC_.
ATOMS_ARTIFACT_SECRET=
