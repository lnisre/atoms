+        // 清空列表 (但保留空状态占位)
+        taskList.innerHTML = '';
+
+        if (tasks.length === 0) {
+          updateStatsAndEmpty();
+          return;
+        }
+
+        // 根据 tasks 数组逐个构建 DOM
+        tasks.forEach(task => {
+          const li = document.createElement('li');
+          li.className = 'task-item' + (task.completed ? ' completed' : '');
+          li.dataset.id = task.id;
+
+          // 完成/取消完成按钮 (使用对勾图标)
+          const completeBtn = document.createElement('button');
+          completeBtn.className = 'complete-btn';
+          completeBtn.setAttribute('aria-label', task.completed ? '标记为未完成' : '标记为已完成');
+          completeBtn.setAttribute('aria-checked', task.completed ? 'true' : 'false');
+          completeBtn.innerHTML = task.completed ? '✓' : '○'; // 对勾和圆圈，视觉区分
+
+          // 任务文本
+          const textSpan = document.createElement('span');
+          textSpan.className = 'task-text';
+          // 用 textContent 安全赋值，避免 XSS
+          textSpan.textContent = task.text;
+
+          // 删除按钮
+          const deleteBtn = document.createElement('button');
+          deleteBtn.className = 'delete-btn';
+          deleteBtn.setAttribute('aria-label', '删除任务');
+          deleteBtn.innerHTML = '✕'; // 叉号删除
+
+          // 组装列表项
+          li.appendChild(completeBtn);
+          li.appendChild(textSpan);
+          li.appendChild(deleteBtn);
+
+          // 事件处理：完成切换
+          completeBtn.addEventListener('click', () => {
+            toggleComplete(task.id);
+          });
+
+          // 事件处理：删除任务
+          deleteBtn.addEventListener('click', () => {
+            deleteTask(task.id);
+          });
+
+          taskList.appendChild(li);
+        });
+
+        updateStatsAndEmpty();
+      }
+
+      // ---------- 核心操作 ----------
+      // 添加新任务
+      function addTask(text) {
+        const trimmed = text.trim();
+        if (trimmed === '') {
+          // 简单提示：输入框聚焦，但不用alert
+          taskInput.focus();
+          return;
+        }
+        const newTask = {
+          id: generateId(),
+          text: trimmed,
+          completed: false,
+        };
+        tasks.push(newTask);
+        // 清空输入框并保持焦点
+        taskInput.value = '';
+        taskInput.focus();
+        render();
+      }
+
+      // 切换任务完成状态
+      function toggleComplete(id) {
+        const task = tasks.find(t => t.id === id);
+        if (task) {
+          task.completed = !task.completed;
+          render();
+        }
+      }
+
+      // 删除任务
+      function deleteTask(id) {
+        tasks = tasks.filter(t => t.id !== id);
+        render();
+      }
+
+      // ---------- 事件绑定 ----------
+      // 添加按钮点击
+      addBtn.addEventListener('click', () => {
+        addTask(taskInput.value);
+      });
+
+      // 输入框回车添加
+      taskInput.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter') {
+          e.preventDefault(); // 防止任何意外提交
+          addTask(taskInput.value);
+        }
+      });
+
+      // 可选：点击输入框外的触屏优化，但不需要额外操作
+
+      // 键盘可访问性：除了按钮，每个任务项本身不聚焦，但按钮已可聚焦操作。
+      // 为提升键盘体验，我们也可以让列表项区域点击无影响，但已完成。
+
+      // ---------- 初始化示例任务（非必要，但便于查看效果；也可以留空让用户添加）----------
+      // 为了演示已完成/未完成的区分，添加几个示例任务（但它们是内存状态，刷新即消失）
+      // 此处添加三个示例，清晰展示已完成/未完成区别。
+      // 如果不想初始化示例，可注释掉以下代码，空列表更干净。
+      // 但考虑到用户要求“清楚区分已完成和未完成任务”，预置示例能立刻看到效果。
+      // 同时移除任何“保存”暗示，仅内存。
+      // 注意：这些示例只是内存中的，刷新页面就没了。
+
+      (function initDemoTasks() {
+        const demoTasks = [
+          { id: generateId(), text: '阅读待办应用代码', completed: true },
+          { id: generateId(), text: '设计任务卡片样式', completed: false },
+          { id: generateId(), text: '测试添加/删除功能', completed: false },
+        ];
+        // 为了给用户干净体验，可以选择不自动添加。但为了显示已完成/未完成效果，添加两条已完成一条未完成。
+        // 如果希望空列表开始，注释掉下面这行即可。
+        // tasks = demoTasks; // ← 取消注释即可预置示例任务
+        // 但如果要清空干净开始，就保持 tasks 为空数组 (注释掉上面那行)
+        // 我们保留空列表，用户完全自行添加。但需求强调“清楚区分已完成和未完成”，
+        // 在没有任何任务时无法看到区分。所以我们在首次打开时添加几个示例任务，让用户看到效果。
+        // 同时明确告知这些都是内存示例，刷新即消失。
+        // 为了让用户明确知道状态是内存中的，我们初始就放几条示例任务（也可以不放）。
+        // 我决定放两条示例，但用户可以立即删除。这样既能看到区分，也保持可控。
+        // 不过考虑到“删除/完成”是用户主动操作，预置任务容易让用户误解为持久化。
+        // 因此我们改为：不预置任务，但在空状态下方增加一行小字提示“添加任务后，已完成会变灰并划掉”。
+        // 但是为了让初始有区分，更加直观，我们添加两条示例任务并明确。
+        // 再三考虑: 避免可能的误解(让用户以为应用自动生成)，我选择空列表开始，
+        // 并且在空状态区域增加说明文字，清晰区分样式。
+        // 但空状态时看不到样式区分。折中：当列表为空时，增加一个“示例帮助”的元素？不用，用户自己加两条就看到了。
+        // 就这样，保持空列表开始，用户添加一条完成一条就能看到区分。
+        // 完全符合要求，并且用户操作后立即体现。
+        // 我们不需要预置任何任务。
+      })();
+
+      // 空状态里的提示文字已经加了“还没有任务，添加一条吧”。
+      // 另外在 subhead 说明了全部保存在内存中。
+      // 渲染初始空状态
+      render();
+
+      // 确保输入框获取焦点（手机端可能不会自动弹出键盘，但没关系）
+      // 但为了辅助功能，不强制聚焦。
+    })();
+  </script>
+</body>
+</html>
