 <input\n      type=\"text\"\n      id=\"taskInput\"\n      placeholder=\"添加新任务…\"\n      aria-label=\"新任务内容\"\n      maxlength=\"200\"\n      disabled\n      autocomplete=\"off\"\n    >\n    <button type=\"button\" class=\"btn-add\" id=\"addBtn\" disabled aria-label=\"添加任务\">\n      添加\n    </button>\n  </div>\n\n  <div class=\"priority-row\" id=\"priorityRow\" role=\"group\" aria-label=\"选择新任务优先级\">\n    <span class=\"priority-label\">优先级</span>\n    <button type=\"button\" class=\"priority-choice\" data-priority=\"high\" disabled aria-pressed=\"false\">高</button>\n    <button type=\"button\" class=\"priority-choice\" data-priority=\"normal\" disabled aria-pressed=\"false\">中</button>\n    <button type=\"button\" class=\"priority-choice\" data-priority=\"low\" disabled aria-pressed=\"false\">低</button>\n  </div>\n\n  <div class=\"loading\" id=\"loadingMsg\">正在加载待办数据…</div>\n\n  <div class=\"section hidden\" id=\"activeSection\">\n    <div class=\"section-header\">\n      未完成\n      <span class=\"count\" id=\"activeCount\">0</span>\n    </div>\n    <ul class=\"task-list\" id=\"activeList\"></ul>\n    <div class=\"empty hidden\" id=\"activeEmpty\">暂无未完成任务 🎉</div>\n  </div>\n\n  <div class=\"section hidden\" id=\"doneSection\">\n    <div class=\"section-header\">\n      已完成\n      <span class=\"count\" id=\"doneCount\">0</span>\n    </div>\n    <ul class=\"task-list\" id=\"doneList\"></ul>\n    <div class=\"empty hidden\" id=\"doneEmpty\">还没有已完成的任务</div>\n  </div>\n\n  <div class=\"recovery-note\">\n    🔒 数据仅保存在此浏览器和站点中。清除浏览器站点数据会导致待办丢失，恢复仅限于当前浏览器和站点。\n  </div>\n</div>\n\n<script>\n(function () {\n  'use strict';\n\n  // ---------- DOM ----------\n  var statusDot = document.getElementById('statusDot');\n  var statusText = document.getElementById('statusText');\n  var errorBanner = document.getElementById('errorBanner');\n  var errorText = document.getElementById('errorText');\n  var taskInput = document.getElementById('taskInput');\n  var addBtn = document.getElementById('addBtn');\n  var loadingMsg = document.getElementById('loadingMsg');\n  var activeSection = document.getElementById('activeSection');\n  var doneSection = document.getElementById('doneSection');\n  var activeList = document.getElementById('activeList');\n  var doneList = document.getElementById('doneList');\n  var activeCount = document.getElementById('activeCount');\n  var doneCount = document.getElementById('doneCount');\n  var activeEmpty = document.getElementById('activeEmpty');\n  var doneEmpty = document.getElementById('doneEmpty');\n  var priorityChoices = document.querySelectorAll('.priority-choice');\n  var filterBtns = document.querySelectorAll('.filter-btn');\n\n  // ---------- Constants ----------\n  var PRIORITIES = ['low', 'normal', 'high'];\n  var PRIORITY_LABEL = { low: '低', normal: '中', high: '高' };\n  var DEFAULT_PRIORITY = 'normal';\n\n  // ---------- State ----------\n  var tasks = [];\n  var currentPriority = DEFAULT_PRIORITY;\n  var currentFilter = 'all';\n  var appReady = false;\n\n  // ---------- Helpers ----------\n  function uid() {\n    return Date.now().toString(36) + Math.random().toString(36).slice(2, 9);\n  }\n\n  function normalizePriority(p) {\n    return PRIORITIES.indexOf(p) !== -1 ? p : DEFAULT_PRIORITY;\n  }\n\n  function setStatus(type, msg) {\n    if (type === 'idle') {\n      statusDot.hidden = true;\n      statusText.textContent = msg || '';\n    } else if (type === 'saving') {\n      statusDot.hidden = false;\n      statusDot.className = 'dot saving';\n      statusText.textContent = msg || '保存中…';\n    } else if (type === 'saved') {\n      statusDot.hidden = false;\n      statusDot.className = 'dot';\n      statusText.textContent = msg || '已更新';\n    } else if (type === 'error') {\n      statusDot.hidden = false;\n      statusDot.className = 'dot error';\n      statusText.textContent = msg || '保存失败';\n    }\n  }\n\n  function showError(msg) {\n    errorText.textContent = msg;\n    errorBanner.classList.remove('hidden');\n  }\n\n  function hideError() {\n    errorBanner.classList.add('hidden');\n  }\n\n  function setEditingEnabled(enabled) {\n    appReady = enabled;\n    taskInput.disabled = !enabled;\n    addBtn.disabled = !enabled;\n    for (var i = 0; i < priorityChoices.length; i++) {\n      priorityChoices[i].disabled = !enabled;\n    }\n    for (var f = 0; f < filterBtns.length; f++) {\n      filterBtns[f].disabled = !enabled;\n    }\n    var buttons = document.querySelectorAll('.task-check, .btn-delete, .edit-priority-btn');\n    for (var j = 0; j < buttons.length; j++) {\n      buttons[j].disabled = !enabled;\n    }\n  }\n\n  function updatePriorityUI() {\n    for (var i = 0; i < priorityChoices.length; i++) {\n      var btn = priorityChoices[i];\n      var isSel = btn.dataset.priority === currentPriority;\n      btn.classList.toggle('selected', isSel);\n      btn.setAttribute('aria-pressed', isSel ? 'true' : 'false');\n    }\n  }\n\n  function updateFilterUI() {\n    for (var i = 0; i < filterBtns.length; i++) {\n      var btn = filterBtns[i];\n      var isSel = btn.dataset.filter === currentFilter;\n      btn.classList.toggle('active', isSel);\n      btn.setAttribute('aria-pressed', isSel ? 'true' : 'false');\n    }\n  }\n\n  // ---------- Render ----------\n  function createTaskItem(task) {\n    var li = document.createElement('li');\n    li.className = 'task-item' + (task.done ? ' done' : '');\n    li.dataset.id = task.id;\n    li.dataset.priority = task.priority;\n\n    var checkBtn = document.createElement('button');\n    checkBtn.type = 'button';\n    checkBtn.className = 'task-check';\n    checkBtn.setAttribute('aria-label', (task.done ? '标记为未完成：' : '标记为已完成：') + task.text);\n    checkBtn.disabled = !appReady;\n    checkBtn.innerHTML =\n      '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg>';\n    checkBtn.addEventListener('click', function () {\n      handleToggle(task.id);\n    });\n\n    var span = document.createElement('span');\n    span.className = 'task-text';\n    span.textContent = task.text;\n\n    var tag = document.createElement('span');\n    tag.className = 'task-tag';\n    tag.dataset.priority = task.priority;\n    tag.textContent = PRIORITY_LABEL[task.priority];\n\n    // 直接修改已有任务优先级的按钮组\n    var editRow = document.createElement('div');\n    editRow.className = 'edit-priority-row';\n    editRow.setAttribute('role', 'group');\n    editRow.setAttribute('aria-label', '修改优先级：' + task.text);\n    for (var p = 0; p < PRIORITIES.length; p++) {\n      (function (pri) {\n        var pBtn = document.createElement('button');\n        pBtn.type = 'button';\n        pBtn.className = 'edit-priority-btn' + (task.priority === pri ? ' current' : '');\n        pBtn.dataset.priority = pri;\n        pBtn.textContent = PRIORITY_LABEL[pri];\n        pBtn.disabled = !appReady || task.priority === pri;\n        pBtn.setAttribute('aria-label',\n          task.priority === pri\n            ? '当前优先级：' + PRIORITY_LABEL[pri]\n            : '设为' + PRIORITY_LABEL[pri] + '优先级：' + task.text);\n        if (task.priority === pri) {\n          pBtn.setAttribute('aria-pressed', 'true');\n        }\n        pBtn.addEventListener('click', function () {\n          handlePriorityChange(task.id, pri);\n        });\n        editRow.appendChild(pBtn);\n      })(PRIORITIES[p]);\n    }\n\n    var delBtn = document.createElement('button');\n    delBtn.type = 'button';\n    delBtn.className = 'btn-delete';\n    delBtn.setAttribute('aria-label', '删除任务：' + task.text);\n    delBtn.disabled = !appReady;\n    delBtn.innerHTML =\n      '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><polyline points=\"3 6 5 6 21 6\"></polyline><path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"></path><line x1=\"10\" y1=\"11\" x2=\"10\" y2=\"17\"></line><line x1=\"14\" y1=\"11\" x2=\"14\" y2=\"17\"></line></svg>';\n    delBtn.addEventListener('click', function () {\n      handleDelete(task.id);\n    });\n\n    li.appendChild(checkBtn);\n    li.appendChild(span);\n    li.appendChild(tag);\n    li.appendChild(editRow);\n    li.appendChild(delBtn);\n    return li;\n  }\n\n  function matchesFilter(task) {\n    return currentFilter === 'all' || task.priority === currentFilter;\n  }\n\n  function render() {\n    var active = [];\n    var done = [];\n    for (var i = 0; i < tasks.length; i++) {\n      if (!matchesFilter(tasks[i])) continue;\n      if (tasks[i].done) done.push(tasks[i]);\n      else active.push(tasks[i]);\n    }\n\n    activeList.innerHTML = '';\n    doneList.innerHTML = '';\n\n    for (var a = 0; a < active.length; a++) {\n      activeList.appendChild(createTaskItem(active[a]));\n    }\n    for (var d = 0; d < done.length; d++) {\n      doneList.appendChild(createTaskItem(done[d]));\n    }\n\n    activeCount.textContent = active.length;\n    doneCount.textContent = done.length;\n\n    var totalVisible = active.length + done.length;\n\n    activeSection.classList.remove('hidden');\n    doneSection.classList.toggle('hidden', done.length === 0);\n    activeEmpty.classList.toggle('hidden', active.length > 0);\n    doneEmpty.classList.toggle('hidden', done.length > 0);\n\n    if (totalVisible === 0) {\n      activeEmpty.textContent = tasks.length === 0 ? '暂无未完成任务 🎉' : '当前筛选下没有匹配的任务';\n      activeEmpty.classList.remove('hidden');\n    } else {\n      activeEmpty.textContent = '暂无未完成任务 🎉';\n    }\n  }\n\n  // ---------- Saving ----------\n  function serialize() {\n    return {\n      tasks: tasks,\n      currentPriority: currentPriority,\n      currentFilter: currentFilter\n    };\n  }\n\n  // ---------- Mutations ----------\n  // 单一异步变更处理器：更新状态 → 渲染 → 禁用编辑 → saveState → 恢复或报错\n  async function runMutation(mutate) {\n    if (!appReady) return;\n\n    mutate();\n    render();\n    setEditingEnabled(false);\n    setStatus('saving', '保存中…');\n\n    var snapshot = serialize();\n\n    try {\n      await window.atoms.saveState(snapshot);\n      setStatus('saved', '已更新');\n      hideError();\n      setEditingEnabled(true);\n      updatePriorityUI();\n      updateFilterUI();\n      if (taskInput === document.activeElement || taskInput.value === '') {\n        taskInput.focus();\n      }\n    } catch (err) {\n      setStatus('error', '保存失败');\n      showError('保存失败：' + (err && err.message ? err.message : '未知错误') + '。你的修改可能未保存，请重试。');\n      // 不重新启用编辑，避免覆盖未确认的数据\n    }\n  }\n\n  function handleAdd() {\n    if (!appReady) return;\n    var text = taskInput.value.trim();\n    if (!text) return;\n    var priority = currentPriority;\n    taskInput.value = '';\n    runMutation(function () {\n      tasks.push({ id: uid(), text: text, done: false, priority: priority });\n    });\n  }\n\n  function handleToggle(id) {\n    if (!appReady) return;\n    runMutation(function () {\n      for (var i = 0; i < tasks.length; i++) {\n        if (tasks[i].id === id) {\n          tasks[i].done = !tasks[i].done;\n          break;\n        }\n      }\n    });\n  }\n\n  function handleDelete(id) {\n    if (!appReady) return;\n    runMutation(function () {\n      for (var i = 0; i < tasks.length; i++) {\n        if (tasks[i].id === id) {\n          tasks.splice(i, 1);\n          break;\n        }\n      }\n    });\n  }\n\n  function handlePriorityChange(id, newPriority) {\n    if (!appReady) return;\n    var target = null;\n    for (var i = 0; i < tasks.length; i++) {\n      if (tasks[i].id === id) { target = tasks[i]; break; }\n    }\n    if (!target || target.priority === newPriority) return;\n    runMutation(function () {\n      for (var j = 0; j < tasks.length; j++) {\n        if (tasks[j].id === id) {\n          tasks[j].priority = newPriority;\n          break;\n        }\n      }\n    });\n  }\n\n  function handlePrioritySelect(p) {\n    if (!appReady || currentPriority === p) return;\n    currentPriority = p;\n    updatePriorityUI();\n    runMutation(function () {});\n  }\n\n  function handleFilterSelect(f) {\n    if (!appReady || currentFilter === f) return;\n    currentFilter = f;\n    updateFilterUI();\n    render();\n    setEditingEnabled(false);\n    setStatus('saving', '保存中…');\n    var snapshot = serialize();\n    window.atoms.saveState(snapshot).then(function () {\n      setStatus('saved', '已更新');\n      hideError();\n      setEditingEnabled(true);\n      updatePriorityUI();\n      updateFilterUI();\n    }).catch(function (err) {\n      setStatus('error', '保存失败');\n      showError('保存筛选失败：' + (err && err.message ? err.message : '未知错误') + '。');\n    });\n  }\n\n  // ---------- Load ----------\n  async function init() {\n    loadingMsg.classList.remove('hidden');\n    activeSection.classList.add('hidden');\n    doneSection.classList.add('hidden');\n    setStatus('idle', '正在加载…');\n    setEditingEnabled(false);\n\n    var loaded = null;\n    try {\n      loaded = await window.atoms.loadState();\n    } catch (err) {\n      loadingMsg.classList.add('hidden');\n      setStatus('error', '加载失败');\n      showError('无法读取已保存的数据：' + (err && err.message ? err.message : '未知错误') + '。编辑已禁用，不会覆盖现有数据。');\n      return;\n    }\n\n    if (loaded && Array.isArray(loaded.tasks)) {\n      tasks = loaded.tasks.map(function (t) {\n        return {\n          id: typeof t.id === 'string' ? t.id : uid(),\n          text: typeof t.text === 'string' ? t.text : '',\n          done: !!t.done,\n          priority: normalizePriority(t.priority)\n        };\n      }).filter(function (t) { return t.text.length > 0; });\n\n      if (loaded.currentPriority && PRIORITIES.indexOf(loaded.currentPriority) !== -1) {\n        currentPriority = loaded.currentPriority;\n      }\n      if (typeof loaded.currentFilter === 'string' &&\n          (loaded.currentFilter === 'all' || PRIORITIES.indexOf(loaded.currentFilter) !== -1)) {\n        currentFilter = loaded.currentFilter;\n      }\n    } else {\n      tasks = [];\n    }\n\n    loadingMsg.classList.add('hidden');\n    updatePriorityUI();\n    updateFilterUI();\n    render();\n    setEditingEnabled(true);\n    setStatus('saved', '已就绪');\n    taskInput.focus();\n  }\n\n  // ---------- Events ----------\n  addBtn.addEventListener('click', handleAdd);\n\n  taskInput.addEventListener('keydown', function (e) {\n    if (e.key === 'Enter') {\n      e.preventDefault();\n      handleAdd();\n    }\n  });\n\n  for (var i = 0; i < priorityChoices.length; i++) {\n    (function (btn) {\n      btn.addEventListener('click', function () {\n        handlePrioritySelect(btn.dataset.priority);\n      });\n    })(priorityChoices[i]);\n  }\n\n  for (var f = 0; f < filterBtns.length; f++) {\n    (function (btn) {\n      btn.addEventListener('click', function () {\n        handleFilterSelect(btn.dataset.filter);\n      });\n    })(filterBtns[f]);\n  }\n\n  // ---------- Start ----------\n  if (window.atoms && typeof window.atoms.loadState === 'function') {\n    init();\n  } else {\n    loadingMsg.classList.add('hidden');\n    setStatus('error', '初始化失败');\n    showError('应用初始化失败：存储接口不可用。编辑已禁用。');\n  }\n})();\n</script>\n</body>\n</html>",
