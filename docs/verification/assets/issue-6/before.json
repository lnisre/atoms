      "result": {
        "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes\">\n<title>待办清单</title>\n<style>\n  * {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n    -webkit-tap-highlight-color: transparent;\n  }\n  body {\n    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;\n    background: #f2f4f8;\n    min-height: 100vh;\n    display: flex;\n    justify-content: center;\n    padding: 12px;\n    color: #1a202c;\n  }\n  .app {\n    width: 100%;\n    max-width: 540px;\n    background: #ffffff;\n    border-radius: 20px;\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);\n    padding: 20px 16px 28px;\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n    height: fit-content;\n    min-height: calc(100vh - 24px);\n  }\n  h1 {\n    font-size: 1.5rem;\n    font-weight: 700;\n    letter-spacing: -0.01em;\n    color: #1e293b;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n  h1 svg {\n    width: 26px;\n    height: 26px;\n    flex-shrink: 0;\n  }\n  .status-bar {\n    font-size: 0.8rem;\n    min-height: 1.2rem;\n    color: #64748b;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    flex-wrap: wrap;\n  }\n  .status-bar .dot {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: #22c55e;\n    flex-shrink: 0;\n  }\n  .status-bar .dot.saving {\n    background: #f59e0b;\n    animation: pulse 1s infinite;\n  }\n  .status-bar .dot.error {\n    background: #ef4444;\n  }\n  @keyframes pulse {\n    0%, 100% { opacity: 1; }\n    50% { opacity: 0.35; }\n  }\n  .input-row {\n    display: flex;\n    gap: 8px;\n  }\n  .input-row input {\n    flex: 1;\n    padding: 12px 14px;\n    border: 1.5px solid #e2e8f0;\n    border-radius: 12px;\n    font-size: 1rem;\n    font-family: inherit;\n    background: #f8fafc;\n    transition: border-color 0.15s, background 0.15s;\n    min-width: 0;\n  }\n  .input-row input:focus {\n    outline: none;\n    border-color: #6366f1;\n    background: #ffffff;\n  }\n  .input-row input:disabled {\n    opacity: 0.5;\n    cursor: not-allowed;\n  }\n  .btn-add {\n    padding: 0 20px;\n    border: none;\n    border-radius: 12px;\n    background: #6366f1;\n    color: #ffffff;\n    font-size: 1rem;\n    font-weight: 600;\n    font-family: inherit;\n    cursor: pointer;\n    white-space: nowrap;\n    transition: background 0.15s, transform 0.1s;\n    display: flex;\n    align-items: center;\n    gap: 4px;\n  }\n  .btn-add:hover:not(:disabled) {\n    background: #4f46e5;\n  }\n  .btn-add:active:not(:disabled) {\n    transform: scale(0.96);\n  }\n  .btn-add:disabled {\n    opacity: 0.5;\n    cursor: not-allowed;\n  }\n  .section {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n  .section-header {\n    font-size: 0.8rem;\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n    color: #94a3b8;\n    padding-left: 4px;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n  .section-header .count {\n    background: #f1f5f9;\n    color: #64748b;\n    border-radius: 20px;\n    padding: 1px 8px;\n    font-size: 0.7rem;\n    font-weight: 700;\n  }\n  .task-list {\n    list-style: none;\n    display: flex;\n    flex-direction: column;\n    gap: 6px;\n  }\n  .task-item {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    padding: 12px 12px;\n    background: #f8fafc;\n    border-radius: 12px;\n    border: 1.5px solid #eef2f6;\n    transition: background 0.15s, opacity 0.15s;\n    min-height: 52px;\n  }\n  .task-item.done {\n    background: #f0fdf4;\n    border-color: #dcfce7;\n  }\n  .task-check {\n    width: 24px;\n    height: 24px;\n    border-radius: 50%;\n    border: 2px solid #cbd5e1;\n    background: #ffffff;\n    flex-shrink: 0;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 0;\n    transition: background 0.15s, border-color 0.15s;\n  }\n  .task-check:hover:not(:disabled) {\n    border-color: #6366f1;\n  }\n  .task-check:disabled {\n    opacity: 0.6;\n    cursor: not-allowed;\n  }\n  .task-item.done .task-check {\n    background: #22c55e;\n    border-color: #22c55e;\n  }\n  .task-check svg {\n    width: 14px;\n    height: 14px;\n    display: none;\n    stroke: #ffffff;\n    stroke-width: 3;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n    fill: none;\n  }\n  .task-item.done .task-check svg {\n    display: block;\n  }\n  .task-text {\n    flex: 1;\n    font-size: 0.95rem;\n    line-height: 1.4;\n    word-break: break-word;\n    transition: color 0.15s, text-decoration 0.15s;\n    min-width: 0;\n  }\n  .task-item.done .task-text {\n    color: #86a08e;\n    text-decoration: line-through;\n  }\n  .btn-delete {\n    width: 34px;\n    height: 34px;\n    border-radius: 10px;\n    border: none;\n    background: transparent;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    transition: background 0.15s;\n    padding: 0;\n  }\n  .btn-delete:hover:not(:disabled) {\n    background: #fee2e2;\n  }\n  .btn-delete:disabled {\n    opacity: 0.4;\n    cursor: not-allowed;\n  }\n  .btn-delete svg {\n    width: 18px;\n    height: 18px;\n    stroke: #94a3b8;\n    stroke-width: 2;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n    fill: none;\n    transition: stroke 0.15s;\n  }\n  .btn-delete:hover:not(:disabled) svg {\n    stroke: #ef4444;\n  }\n  .empty {\n    text-align: center;\n    color: #94a3b8;\n    font-size: 0.9rem;\n    padding: 24px 8px;\n    line-height: 1.5;\n  }\n  .error-banner {\n    background: #fef2f2;\n    border: 1.5px solid #fecaca;\n    border-radius: 12px;\n    padding: 12px 14px;\n    font-size: 0.85rem;\n    color: #b91c1c;\n    line-height: 1.5;\n    display: flex;\n    gap: 8px;\n    align-items: flex-start;\n  }\n  .error-banner svg {\n    width: 18px;\n    height: 18px;\n    flex-shrink: 0;\n    margin-top: 1px;\n    stroke: #ef4444;\n    stroke-width: 2;\n    fill: none;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n  .recovery-note {\n    font-size: 0.7rem;\n    color: #94a3b8;\n    line-height: 1.5;\n    text-align: center;\n    padding: 4px 8px;\n    border-top: 1px solid #f1f5f9;\n    margin-top: auto;\n  }\n  .hidden {\n    display: none !important;\n  }\n  .loading {\n    text-align: center;\n    color: #94a3b8;\n    font-size: 0.9rem;\n    padding: 32px 8px;\n  }\n  @media (max-width: 400px) {\n    .app {\n      padding: 16px 10px 20px;\n      border-radius: 16px;\n    }\n    .btn-add {\n      padding: 0 14px;\n      font-size: 0.9rem;\n    }\n    .input-row input {\n      font-size: 0.95rem;\n      padding: 11px 12px;\n    }\n  }\n</style>\n</head>\n<body>\n<div class=\"app\" id=\"app\">\n  <h1>\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#6366f1\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n      <path d=\"M9 11l3 3L22 4\"></path>\n      <path d=\"M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11\"></path>\n    </svg>\n    待办清单\n  </h1>\n\n  <div class=\"status-bar\" id=\"statusBar\" role=\"status\" aria-live=\"polite\">\n    <span class=\"dot\" id=\"statusDot\" hidden></span>\n    <span id=\"statusText\">正在加载…</span>\n  </div>\n\n  <div class=\"error-banner hidden\" id=\"errorBanner\" role=\"alert\">\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n      <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line>\n      <line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line>\n    </svg>\n    <span id=\"errorText\"></span>\n  </div>\n\n  <div class=\"input-row\">\n    <input\n      type=\"text\"\n      id=\"taskInput\"\n      placeholder=\"添加新任务…\"\n      aria-label=\"新任务内容\"\n      maxlength=\"200\"\n      disabled\n      autocomplete=\"off\"\n    >\n    <button type=\"button\" class=\"btn-add\" id=\"addBtn\" disabled aria-label=\"添加任务\">\n      添加\n    </button>\n  </div>\n\n  <div class=\"loading\" id=\"loadingMsg\">正在加载待办数据…</div>\n\n  <div class=\"section hidden\" id=\"activeSection\">\n    <div class=\"section-header\">\n      未完成\n      <span class=\"count\" id=\"activeCount\">0</span>\n    </div>\n    <ul class=\"task-list\" id=\"activeList\"></ul>\n    <div class=\"empty hidden\" id=\"activeEmpty\">暂无未完成任务 🎉</div>\n  </div>\n\n  <div class=\"section hidden\" id=\"doneSection\">\n    <div class=\"section-header\">\n      已完成\n      <span class=\"count\" id=\"doneCount\">0</span>\n    </div>\n    <ul class=\"task-list\" id=\"doneList\"></ul>\n    <div class=\"empty hidden\" id=\"doneEmpty\">还没有已完成的任务</div>\n  </div>\n\n  <div class=\"recovery-note\">\n    🔒 数据仅保存在此浏览器和站点中。清除浏览器站点数据会导致待办丢失，恢复仅限于当前浏览器。\n  </div>\n</div>\n\n<script>\n(function () {\n  'use strict';\n\n  // ---------- DOM ----------\n  var statusDot = document.getElementById('statusDot');\n  var statusText = document.getElementById('statusText');\n  var errorBanner = document.getElementById('errorBanner');\n  var errorText = document.getElementById('errorText');\n  var taskInput = document.getElementById('taskInput');\n  var addBtn = document.getElementById('addBtn');\n  var loadingMsg = document.getElementById('loadingMsg');\n  var activeSection = document.getElementById('activeSection');\n  var doneSection = document.getElementById('doneSection');\n  var activeList = document.getElementById('activeList');\n  var doneList = document.getElementById('doneList');\n  var activeCount = document.getElementById('activeCount');\n  var doneCount = document.getElementById('doneCount');\n  var activeEmpty = document.getElementById('activeEmpty');\n  var doneEmpty = document.getElementById('doneEmpty');\n\n  // ---------- State ----------\n  var tasks = [];\n  var appReady = false;\n  var isSaving = false;\n\n  // ---------- Helpers ----------\n  function uid() {\n    return Date.now().toString(36) + Math.random().toString(36).slice(2, 9);\n  }\n\n  function setStatus(type, msg) {\n    if (type === 'idle') {\n      statusDot.hidden = true;\n      statusText.textContent = msg || '';\n    } else if (type === 'saving') {\n      statusDot.hidden = false;\n      statusDot.className = 'dot saving';\n      statusText.textContent = msg || '保存中…';\n    } else if (type === 'saved') {\n      statusDot.hidden = false;\n      statusDot.className = 'dot';\n      statusText.textContent = msg || '已保存';\n    } else if (type === 'error') {\n      statusDot.hidden = false;\n      statusDot.className = 'dot error';\n      statusText.textContent = msg || '保存失败';\n    }\n  }\n\n  function showError(msg) {\n    errorText.textContent = msg;\n    errorBanner.classList.remove('hidden');\n  }\n\n  function hideError() {\n    errorBanner.classList.add('hidden');\n  }\n\n  function setEditingEnabled(enabled) {\n    appReady = enabled;\n    taskInput.disabled = !enabled;\n    addBtn.disabled = !enabled;\n    // 任务项内的按钮也受控\n    var buttons = document.querySelectorAll('.task-check, .btn-delete');\n    for (var i = 0; i < buttons.length; i++) {\n      buttons[i].disabled = !enabled;\n    }\n  }\n\n  // ---------- Render ----------\n  function createTaskItem(task) {\n    var li = document.createElement('li');\n    li.className = 'task-item' + (task.done ? ' done' : '');\n    li.dataset.id = task.id;\n\n    // 完成按钮\n    var checkBtn = document.createElement('button');\n    checkBtn.type = 'button';\n    checkBtn.className = 'task-check';\n    checkBtn.setAttribute('aria-label', task.done ? '标记为未完成' : '标记为已完成');\n    checkBtn.disabled = !appReady;\n    checkBtn.innerHTML =\n      '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg>';\n    checkBtn.addEventListener('click', function () {\n      handleToggle(task.id);\n    });\n\n    // 文本\n    var span = document.createElement('span');\n    span.className = 'task-text';\n    span.textContent = task.text;\n\n    // 删除按钮\n    var delBtn = document.createElement('button');\n    delBtn.type = 'button';\n    delBtn.className = 'btn-delete';\n    delBtn.setAttribute('aria-label', '删除任务');\n    delBtn.disabled = !appReady;\n    delBtn.innerHTML =\n      '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><polyline points=\"3 6 5 6 21 6\"></polyline><path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"></path><line x1=\"10\" y1=\"11\" x2=\"10\" y2=\"17\"></line><line x1=\"14\" y1=\"11\" x2=\"14\" y2=\"17\"></line></svg>';\n    delBtn.addEventListener('click', function () {\n      handleDelete(task.id);\n    });\n\n    li.appendChild(checkBtn);\n    li.appendChild(span);\n    li.appendChild(delBtn);\n    return li;\n  }\n\n  function render() {\n    var active = [];\n    var done = [];\n    for (var i = 0; i < tasks.length; i++) {\n      if (tasks[i].done) done.push(tasks[i]);\n      else active.push(tasks[i]);\n    }\n\n    activeList.innerHTML = '';\n    doneList.innerHTML = '';\n\n    for (var a = 0; a < active.length; a++) {\n      activeList.appendChild(createTaskItem(active[a]));\n    }\n    for (var d = 0; d < done.length; d++) {\n      doneList.appendChild(createTaskItem(done[d]));\n    }\n\n    activeCount.textContent = active.length;\n    doneCount.textContent = done.length;\n\n    activeSection.classList.toggle('hidden', tasks.length === 0 && active.length === 0 && done.length === 0);\n    doneSection.classList.toggle('hidden', done.length === 0);\n    activeEmpty.classList.toggle('hidden', active.length > 0);\n    doneEmpty.classList.toggle('hidden', done.length > 0);\n\n    // 如果两个列表都为空，显示全局空状态\n    if (tasks.length === 0) {\n      activeSection.classList.remove('hidden');\n      activeEmpty.classList.remove('hidden');\n    }\n  }\n\n  // ---------- Saving ----------\n  function serialize() {\n    return { tasks: tasks };\n  }\n\n  async function persist(snapshot) {\n    // 同步调用 saveState，不排队、不防抖\n    try {\n      await window.atoms.saveState(snapshot);\n      setStatus('saved', '已保存');\n      hideError();\n      return true;\n    } catch (err) {\n      setStatus('error', '保存失败');\n      showError('保存失败：' + (err && err.message ? err.message : '未知错误') + '。你的修改可能未生效，请重试。');\n      return false;\n    }\n  }\n\n  // ---------- Mutations ----------\n  async function handleAdd() {\n    if (!appReady || isSaving) return;\n    var text = taskInput.value.trim();\n    if (!text) return;\n\n    var newTask = { id: uid(), text: text, done: false };\n    tasks.push(newTask);\n    taskInput.value = '';\n    render();\n\n    isSaving = true;\n    setEditingEnabled(false);\n    setStatus('saving', '保存中…');\n\n    var snapshot = serialize();\n    var ok = await persist(snapshot);\n\n    isSaving = false;\n    setEditingEnabled(true);\n    if (ok) {\n      taskInput.focus();\n    } else {\n      taskInput.focus();\n    }\n  }\n\n  async function handleToggle(id) {\n    if (!appReady || isSaving) return;\n    var task = null;\n    for (var i = 0; i < tasks.length; i++) {\n      if (tasks[i].id === id) { task = tasks[i]; break; }\n    }\n    if (!task) return;\n\n    task.done = !task.done;\n    render();\n\n    isSaving = true;\n    setEditingEnabled(false);\n    setStatus('saving', '保存中…');\n\n    var snapshot = serialize();\n    var ok = await persist(snapshot);\n\n    isSaving = false;\n    setEditingEnabled(true);\n    if (!ok) {\n      // 回滚 UI 状态以匹配未保存的失败？按平台要求：修改可能未生效\n      // 保持当前界面，但状态区提示失败。\n    }\n  }\n\n  async function handleDelete(id) {\n    if (!appReady || isSaving) return;\n    var idx = -1;\n    for (var i = 0; i < tasks.length; i++) {\n      if (tasks[i].id === id) { idx = i; break; }\n    }\n    if (idx === -1) return;\n\n    tasks.splice(idx, 1);\n    render();\n\n    isSaving = true;\n    setEditingEnabled(false);\n    setStatus('saving', '保存中…');\n\n    var snapshot = serialize();\n    var ok = await persist(snapshot);\n\n    isSaving = false;\n    setEditingEnabled(true);\n  }\n\n  // ---------- Load ----------\n  async function init() {\n    loadingMsg.classList.remove('hidden');\n    activeSection.classList.add('hidden');\n    doneSection.classList.add('hidden');\n    setStatus('idle', '正在加载…');\n    setEditingEnabled(false);\n\n    var loaded = null;\n    try {\n      loaded = await window.atoms.loadState();\n    } catch (err) {\n      loadingMsg.classList.add('hidden');\n      setStatus('error', '加载失败');\n      showError('无法读取已保存的数据：' + (err && err.message ? err.message : '未知错误') + '。编辑已禁用，不会覆盖现有数据。');\n      return; // 保持编辑禁用\n    }\n\n    // 恢复状态\n    if (loaded && Array.isArray(loaded.tasks)) {\n      tasks = loaded.tasks.map(function (t) {\n        return {\n          id: typeof t.id === 'string' ? t.id : uid(),\n          text: typeof t.text === 'string' ? t.text : '',\n          done: !!t.done\n        };\n      }).filter(function (t) { return t.text.length > 0; });\n    } else {\n      // 默认：空列表（首次使用）\n      tasks = [];\n    }\n\n    loadingMsg.classList.add('hidden');\n    render();\n    setEditingEnabled(true);\n    setStatus('saved', '已就绪');\n    taskInput.focus();\n  }\n\n  // ---------- Events ----------\n  addBtn.addEventListener('click', handleAdd);\n\n  taskInput.addEventListener('keydown', function (e) {\n    if (e.key === 'Enter') {\n      e.preventDefault();\n      handleAdd();\n    }\n  });\n\n  // ---------- Start ----------\n  if (window.atoms && typeof window.atoms.loadState === 'function') {\n    init();\n  } else {\n    loadingMsg.classList.add('hidden');\n    setStatus('error', '初始化失败');\n    showError('应用初始化失败：存储接口不可用。编辑已禁用。');\n  }\n})();\n</script>\n</body>\n</html>",
