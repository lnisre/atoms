modify('增加任务优先级与筛选')
(async()=>{const f=page.frameLocator('iframe');await expect(f.getByRole('button',{name:'标记为未完成',exact:true})).toBeVisible();await expect(f.getByText('优先级：中',{exact:true})).toBeVisible();await f.getByRole('group',{name:'选择新任务优先级'}).getByRole('button',{name:'高',exact:true}).click();await f.getByLabel('新任务内容').fill('原生M1-试用新增');await f.getByRole('button',{name:'添加任务',exact:true}).click();await expect(f.getByText('原生M1-试用新增',{exact:true})).toBeVisible();await intact();await page.screenshot({path:out+'/round-1.png',fullPage:true});return true})()
modify('把筛选放到顶部')
eval(readFileSync(out+'/verify-actions.js','utf8'))
(async()=>{await page.getByRole('button',{name:'放弃本轮修改'}).click();const f=page.frameLocator('iframe');await expect(f.getByRole('button',{name:'标记为未完成',exact:true})).toBeVisible();await expect(f.getByText('原生M1-试用新增',{exact:true})).toHaveCount(0);await expect(page.getByLabel('本轮对话')).toHaveCount(0);const evidence={formalIntact:await intact(),originalCompletionRestored:true,trialGone:true,dom:await f.locator('body').innerText()};writeFileSync(out+'/discard.json',JSON.stringify(evidence,null,2));await page.screenshot({path:out+'/discard.png',fullPage:true});return evidence})()
