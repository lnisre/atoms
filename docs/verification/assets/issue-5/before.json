    "result": {
      "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes\">\n  <title>待办清单 · 轻量任务</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;\n      background: #f7f9fc;\n      min-height: 100vh;\n      display: flex;\n      justify-content: center;\n      align-items: flex-start;\n      padding: 16px;\n    }\n    .app {\n      width: 100%;\n      max-width: 560px;\n      background: #ffffff;\n      border-radius: 28px;\n      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);\n      padding: 24px 20px 32px;\n      margin-top: 12px;\n    }\n    h1 {\n      font-size: 1.8rem;\n      font-weight: 600;\n      color: #1a2e3b;\n      letter-spacing: -0.02em;\n      margin-bottom: 8px;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n    h1 svg {\n      width: 28px;\n      height: 28px;\n      stroke: #2f6e5a;\n      stroke-width: 2;\n      fill: none;\n    }\n    .subhead {\n      font-size: 0.9rem;\n      color: #5c6f7e;\n      margin-bottom: 24px;\n      padding-left: 4px;\n      border-left: 3px solid #a8d5c4;\n      padding-left: 12px;\n    }\n    .status-bar {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      min-height: 28px;\n      margin-bottom: 12px;\n      font-size: 0.85rem;\n      color: #3b5e6b;\n    }\n    .save-indicator {\n      background: #e8f0ee;\n      padding: 4px 12px;\n      border-radius: 30px;\n      color: #1f5e4b;\n      transition: opacity 0.2s;\n      font-weight: 500;\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n    }\n    .save-indicator.error {\n      background: #ffe3e0;\n      color: #b33a2c;\n    }\n    .input-row {\n      display: flex;\n      gap: 10px;\n      margin-bottom: 28px;\n    }\n    .input-row input {\n      flex: 1;\n      padding: 14px 18px;\n      border: 1.5px solid #dbe4ea;\n      border-radius: 60px;\n      font-size: 1rem;\n      background: #fafdff;\n      outline: none;\n      transition: border 0.2s, box-shadow 0.2s;\n      font-family: inherit;\n    }\n    .input-row input:focus {\n      border-color: #3f8e78;\n      box-shadow: 0 0 0 4px rgba(63, 142, 120, 0.12);\n    }\n    .input-row input:disabled {\n      background: #f0f4f8;\n      color: #8a9aa8;\n      cursor: not-allowed;\n    }\n    .btn {\n      border: none;\n      background: #2f6e5a;\n      color: white;\n      font-size: 1rem;\n      font-weight: 500;\n      padding: 0 24px;\n      border-radius: 60px;\n      cursor: pointer;\n      transition: background 0.15s, transform 0.1s;\n      font-family: inherit;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      min-height: 52px;\n      white-space: nowrap;\n      box-shadow: 0 4px 10px rgba(47, 110, 90, 0.2);\n    }\n    .btn:hover {\n      background: #245845;\n    }\n    .btn:active {\n      transform: scale(0.96);\n    }\n    .btn:disabled {\n      background: #b7c9c2;\n      box-shadow: none;\n      cursor: not-allowed;\n      transform: none;\n    }\n    .task-section {\n      margin-bottom: 26px;\n    }\n    .section-header {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      margin-bottom: 14px;\n    }\n    .section-header h2 {\n      font-size: 1.1rem;\n      font-weight: 600;\n      color: #1e3a47;\n      letter-spacing: 0.01em;\n    }\n    .section-header .count {\n      background: #eef3f1;\n      font-size: 0.8rem;\n      padding: 3px 12px;\n      border-radius: 40px;\n      color: #2a5b4b;\n      font-weight: 500;\n    }\n    .task-list {\n      list-style: none;\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n    }\n    .task-item {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      background: #fafdff;\n      border-radius: 60px;\n      padding: 6px 6px 6px 18px;\n      border: 1px solid #e5edf2;\n      transition: background 0.15s, border 0.15s;\n      animation: fadeSlide 0.18s ease-out;\n    }\n    @keyframes fadeSlide {\n      from { opacity: 0; transform: translateY(6px); }\n      to { opacity: 1; transform: translateY(0); }\n    }\n    .task-item.completed .task-title {\n      text-decoration: line-through;\n      color: #9bb0bb;\n    }\n    .task-item.completed {\n      background: #f3f8f7;\n      border-color: #d5e5e0;\n    }\n    .task-title {\n      flex: 1;\n      font-size: 1rem;\n      color: #1f3c47;\n      word-break: break-word;\n      padding: 10px 0;\n      line-height: 1.4;\n      min-width: 0;\n      transition: color 0.15s, text-decoration 0.15s;\n    }\n    .task-actions {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      flex-shrink: 0;\n    }\n    .icon-btn {\n      background: transparent;\n      border: none;\n      width: 44px;\n      height: 44px;\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      color: #5c7b88;\n      transition: background 0.15s, color 0.15s;\n      padding: 0;\n      font-size: 0;\n      line-height: 0;\n    }\n    .icon-btn:hover {\n      background: #e6efec;\n      color: #1f5e4b;\n    }\n    .icon-btn:active {\n      background: #d0e0da;\n    }\n    .icon-btn svg {\n      width: 22px;\n      height: 22px;\n      stroke: currentColor;\n      stroke-width: 2;\n      fill: none;\n      stroke-linecap: round;\n      stroke-linejoin: round;\n    }\n    .icon-btn.delete:hover {\n      color: #c44536;\n      background: #ffeae6;\n    }\n    .empty-message {\n      text-align: center;\n      padding: 24px 12px;\n      color: #9aafbb;\n      font-size: 0.95rem;\n      border-radius: 60px;\n      background: #fbfefe;\n      border: 1px dashed #cbdae3;\n    }\n    .error-banner {\n      background: #ffe3e0;\n      color: #b33a2c;\n      padding: 14px 18px;\n      border-radius: 40px;\n      font-size: 0.9rem;\n      margin-bottom: 20px;\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      border: 1px solid #f5c6c1;\n    }\n    .footer-note {\n      margin-top: 32px;\n      font-size: 0.75rem;\n      color: #90a6b2;\n      text-align: center;\n      border-top: 1px solid #e2ecf1;\n      padding-top: 18px;\n      line-height: 1.6;\n    }\n    .footer-note strong {\n      font-weight: 600;\n      color: #5b7f8e;\n    }\n    @media (max-width: 420px) {\n      .app { padding: 20px 14px 24px; }\n      h1 { font-size: 1.6rem; }\n      .btn { padding: 0 16px; min-height: 48px; font-size: 0.95rem; }\n      .input-row input { padding: 12px 16px; }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"app\" aria-labelledby=\"app-title\">\n    <h1 id=\"app-title\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n        <path d=\"M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01\" />\n      </svg>\n      待办清单\n    </h1>\n    <div class=\"subhead\">轻量任务 · 自动保存</div>\n\n    <!-- 错误显示区域 -->\n    <div id=\"errorBanner\" class=\"error-banner\" style=\"display: none;\" role=\"alert\"></div>\n\n    <!-- 状态栏 / 保存反馈 -->\n    <div class=\"status-bar\">\n      <span id=\"saveStatus\" class=\"save-indicator\" aria-live=\"polite\"></span>\n    </div>\n\n    <!-- 添加任务 -->\n    <div class=\"input-row\">\n      <input type=\"text\" id=\"taskInput\" placeholder=\"写一个新任务…\" aria-label=\"新任务描述\" disabled autocomplete=\"off\" />\n      <button type=\"button\" id=\"addBtn\" class=\"btn\" disabled>添加</button>\n    </div>\n\n    <!-- 未完成任务区域 -->\n    <section class=\"task-section\" aria-labelledby=\"pending-heading\">\n      <div class=\"section-header\">\n        <h2 id=\"pending-heading\">未完成</h2>\n        <span class=\"count\" id=\"pendingCount\">0</span>\n      </div>\n      <ul class=\"task-list\" id=\"pendingList\" aria-label=\"未完成任务列表\"></ul>\n      <div id=\"pendingEmpty\" class=\"empty-message\" style=\"display: none;\">✨ 没有未完成任务</div>\n    </section>\n\n    <!-- 已完成任务区域 -->\n    <section class=\"task-section\" aria-labelledby=\"completed-heading\">\n      <div class=\"section-header\">\n        <h2 id=\"completed-heading\">已完成</h2>\n        <span class=\"count\" id=\"completedCount\">0</span>\n      </div>\n      <ul class=\"task-list\" id=\"completedList\" aria-label=\"已完成任务列表\"></ul>\n      <div id=\"completedEmpty\" class=\"empty-message\" style=\"display: none;\">🎯 还没有完成的任务</div>\n    </section>\n\n    <div class=\"footer-note\">\n      <strong>数据仅保存在此浏览器和站点</strong><br />\n      清除站点数据将丢失所有任务，恢复范围仅限于当前浏览器。\n    </div>\n  </main>\n\n  <script>\n    (function() {\n      'use strict';\n\n      // ---------- DOM 元素 ----------\n      const taskInput = document.getElementById('taskInput');\n      const addBtn = document.getElementById('addBtn');\n      const pendingList = document.getElementById('pendingList');\n      const completedList = document.getElementById('completedList');\n      const pendingCount = document.getElementById('pendingCount');\n      const completedCount = document.getElementById('completedCount');\n      const pendingEmpty = document.getElementById('pendingEmpty');\n      const completedEmpty = document.getElementById('completedEmpty');\n      const saveStatus = document.getElementById('saveStatus');\n      const errorBanner = document.getElementById('errorBanner');\n\n      // ---------- 状态 ----------\n      let tasks = [];            // [{ id: string, title: string, completed: boolean }]\n      let isReady = false;       // loadState 完成前禁止编辑\n      let isSaving = false;\n      let pendingSaveTimer = null;\n\n      // ---------- 工具函数 ----------\n      function generateId() {\n        return Date.now().toString(36) + Math.random().toString(36).substring(2, 9);\n      }\n\n      // 安全渲染：使用 textContent 避免 XSS\n      function renderTasks() {\n        // 清空列表\n        pendingList.innerHTML = '';\n        completedList.innerHTML = '';\n\n        const pending = tasks.filter(t => !t.completed);\n        const completed = tasks.filter(t => t.completed);\n\n        // 更新计数\n        pendingCount.textContent = pending.length;\n        completedCount.textContent = completed.length;\n\n        // 空状态显示\n        pendingEmpty.style.display = pending.length === 0 ? 'block' : 'none';\n        completedEmpty.style.display = completed.length === 0 ? 'block' : 'none';\n\n        // 渲染未完成任务\n        pending.forEach(task => {\n          const li = createTaskElement(task);\n          pendingList.appendChild(li);\n        });\n\n        // 渲染已完成任务\n        completed.forEach(task => {\n          const li = createTaskElement(task);\n          completedList.appendChild(li);\n        });\n      }\n\n      // 创建单个任务元素\n      function createTaskElement(task) {\n        const li = document.createElement('li');\n        li.className = 'task-item' + (task.completed ? ' completed' : '');\n        li.dataset.id = task.id;\n\n        const titleSpan = document.createElement('span');\n        titleSpan.className = 'task-title';\n        titleSpan.textContent = task.title;   // 安全，不会执行 HTML\n\n        const actionsDiv = document.createElement('div');\n        actionsDiv.className = 'task-actions';\n\n        // 完成/取消完成按钮\n        const toggleBtn = document.createElement('button');\n        toggleBtn.type = 'button';\n        toggleBtn.className = 'icon-btn toggle';\n        toggleBtn.setAttribute('aria-label', task.completed ? '标记为未完成' : '标记为已完成');\n        toggleBtn.innerHTML = task.completed\n          ? '<svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M8 12l2.5 2.5L16 9\" /></svg>'\n          : '<svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\" /><path d=\"M12 8v8M8 12h8\" /></svg>';\n        toggleBtn.addEventListener('click', (e) => {\n          e.stopPropagation();\n          toggleTask(task.id);\n        });\n\n        // 删除按钮\n        const deleteBtn = document.createElement('button');\n        deleteBtn.type = 'button';\n        deleteBtn.className = 'icon-btn delete';\n        deleteBtn.setAttribute('aria-label', '删除任务');\n        deleteBtn.innerHTML = '<svg viewBox=\"0 0 24 24\"><path d=\"M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6\"/></svg>';\n        deleteBtn.addEventListener('click', (e) => {\n          e.stopPropagation();\n          deleteTask(task.id);\n        });\n\n        actionsDiv.appendChild(toggleBtn);\n        actionsDiv.appendChild(deleteBtn);\n        li.appendChild(titleSpan);\n        li.appendChild(actionsDiv);\n        return li;\n      }\n\n      // ---------- 保存状态 ----------\n      async function persistState() {\n        if (!isReady) return;          // 尚未就绪不保存\n\n        if (pendingSaveTimer) {\n          clearTimeout(pendingSaveTimer);\n          pendingSaveTimer = null;\n        }\n\n        if (isSaving) {\n          // 如果正在保存，稍后重试（简化：延迟 100ms 再试）\n          pendingSaveTimer = setTimeout(() => persistState(), 100);\n          return;\n        }\n\n        isSaving = true;\n        updateSaveStatus('正在保存…', false);\n\n        try {\n          await window.atoms.saveState({ tasks: tasks });\n          updateSaveStatus('已保存', false);\n        } catch (err) {\n          console.error('保存失败:', err);\n          updateSaveStatus('保存失败', true);\n          showError('保存失败：' + (err.message || '未知错误'));\n        } finally {\n          isSaving = false;\n        }\n      }\n\n      function updateSaveStatus(text, isError) {\n        saveStatus.textContent = text;\n        if (isError) {\n          saveStatus.classList.add('error');\n        } else {\n          saveStatus.classList.remove('error');\n        }\n      }\n\n      function showError(msg) {\n        errorBanner.textContent = msg;\n        errorBanner.style.display = 'flex';\n      }\n\n      function hideError() {\n        errorBanner.style.display = 'none';\n        errorBanner.textContent = '';\n      }\n\n      // ---------- 任务操作 ----------\n      function addTask() {\n        const title = taskInput.value.trim();\n        if (!title) {\n          showError('任务内容不能为空');\n          return;\n        }\n        if (title.length > 500) {\n          showError('任务内容过长（最多500字）');\n          return;\n        }\n\n        hideError();\n\n        const newTask = {\n          id: generateId(),\n          title: title,\n          completed: false\n        };\n        tasks.push(newTask);\n        renderTasks();\n        taskInput.value = '';\n        taskInput.focus();\n\n        // 自动保存整个状态\n        persistState();\n      }\n\n      function toggleTask(id) {\n        const task = tasks.find(t => t.id === id);\n        if (!task) return;\n\n        task.completed = !task.completed;\n        renderTasks();\n\n        persistState();\n      }\n\n      function deleteTask(id) {\n        tasks = tasks.filter(t => t.id !== id);\n        renderTasks();\n\n        persistState();\n      }\n\n      // ---------- 键盘支持 ----------\n      function handleInputKeydown(e) {\n        if (e.key === 'Enter') {\n          e.preventDefault();\n          if (isReady) {\n            addTask();\n          }\n        }\n      }\n\n      // ---------- 启用/禁用交互 ----------\n      function setInteractive(enabled) {\n        taskInput.disabled = !enabled;\n        addBtn.disabled = !enabled;\n        if (enabled) {\n          taskInput.focus();\n        }\n      }\n\n      // ---------- 初始化 ----------\n      async function init() {\n        setInteractive(false);\n\n        try {\n          // 务必先加载状态\n          const saved = await window.atoms.loadState();\n\n          if (saved && typeof saved === 'object' && Array.isArray(saved.tasks)) {\n            // 恢复保存的任务列表（校验结构）\n            tasks = saved.tasks\n              .filter(item =>\n                item && typeof item === 'object' &&\n                typeof item.id === 'string' &&\n                typeof item.title === 'string' &&\n                typeof item.completed === 'boolean'\n              )\n              .map(item => ({\n                id: item.id,\n                title: item.title,\n                completed: item.completed\n              }));\n            // 去重 ID (防止意外重复)\n            const seen = new Set();\n            tasks = tasks.filter(t => {\n              if (seen.has(t.id)) return false;\n              seen.add(t.id);\n              return true;\n            });\n          } else if (saved === null) {\n            // 全新项目，使用默认空列表\n            tasks = [];\n          } else {\n            // 存在数据但不是预期结构，当作空列表但保留原始数据？不覆盖，只是显示默认。\n            // 为了安全，如果结构不对，使用空数组，但不要 write 覆盖，直到用户操作。\n            tasks = [];\n          }\n\n          renderTasks();\n          isReady = true;\n          setInteractive(true);\n          updateSaveStatus('就绪', false);\n          hideError();\n\n          // 绑定事件（只绑定一次）\n          addBtn.addEventListener('click', addTask);\n          taskInput.addEventListener('keydown', handleInputKeydown);\n\n          // 输入框输入时清除错误\n          taskInput.addEventListener('input', () => {\n            if (errorBanner.style.display !== 'none' && errorBanner.textContent === '任务内容不能为空') {\n              hideError();\n            }\n          });\n\n        } catch (err) {\n          console.error('初始化失败:', err);\n          setInteractive(false);\n          showError('无法加载数据：' + (err.message || '未知错误') + '。请刷新页面重试。');\n          updateSaveStatus('加载失败', true);\n          // 保持禁用，不覆盖任何数据\n        }\n      }\n\n      // 启动\n      init();\n\n      // 暴露极少量调试方法（非必要，但可帮助理解，不暴露内部状态）\n      // 不暴露任何可能被误用的东西。\n\n    })();\n  </script>\n</body>\n</html>",
