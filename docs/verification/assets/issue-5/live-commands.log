modify('增加任务优先级与筛选')
(async()=>{const f=page.frameLocator('iframe');await expect(f.locator('#pendingList .task-item')).toHaveCount(3);await page.screenshot({path:out+'/round-1-defaults.png',fullPage:true});return await f.locator('#pendingList').innerText()})()

eval(readFileSync(out+'/round-1-actions.js','utf8'))
modify('把筛选放到顶部')
(async()=>{const f=page.frameLocator('iframe');const filter=await f.getByRole('group',{name:'按优先级筛选'}).boundingBox();const input=await f.getByLabel('新任务描述').boundingBox();assert.ok(filter.y<input.y);await f.getByRole('button',{name:'删除任务：旧项目修复第二条',exact:true}).click();const evidence={filterAboveInput:true,deleted:await f.getByText('旧项目修复第二条',{exact:true}).count()===0,formalIntact:await intact(),dom:await f.locator('body').innerText()};writeFileSync(out+'/round-2-behavior.json',JSON.stringify(evidence,null,2));await page.screenshot({path:out+'/round-2.png',fullPage:true});return evidence})()
modify('删除任务按钮没有真正删除记录。请修复删除操作，保留优先级、顶部筛选、添加和完成操作，并继续使用现有试用数据。')
